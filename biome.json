{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts"]
  },
  "overrides": [
    {
      "includes": ["apps/web/src/features/auth/server/auth.service.server.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/routes/auth/register.tsx",
        "apps/web/src/features/dashboard/components/dashboard-profile-edit-dialog.tsx",
        "apps/web/src/features/dashboard/components/seller-listing-edit-dialog.tsx",
        "apps/web/src/features/dashboard/components/seller-add-product-dialog.tsx",
        "apps/web/src/components/ui/slider.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
