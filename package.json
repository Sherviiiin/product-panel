{
  "name": "product-pannel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web exec tsc --noEmit && pnpm --filter @repo/db exec tsc --noEmit",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db db:seed"
  }
}